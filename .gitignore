# --- Python ---
.venv/
venv/
env/
__pycache__/
*.py[cod]
*.egg-info/
.Python

# --- macOS ---
.DS_Store

# --- runtime state (regenerated by the launcher) ---
check.json

# --- third-party integrated tools ---
# The launcher installs these on demand via its multi-backend engine
# (apt/pip/pipx/git/brew/apk/dnf/pacman), so they are not vendored here.
# This also keeps each tool under its own upstream and license, and keeps
# large data (e.g. wordlists) and nested git repos out of this repository.
tools/

# --- stray large/binary artifacts ---
*.pack
*.iso
*.img

# editor backups
*.bak
